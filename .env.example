# Set these in the server environment. Never commit a real API key.
AGENT_API_KEY=
AGENT_API_BASE=https://api.openai.com/v1
AGENT_MODEL=gpt-4.1-mini
PORT=3000
# For Google Gemini: set AGENT_PROVIDER=gemini and provide GEMINI_API_KEY.
# If AGENT_PROVIDER is omitted, a present GEMINI_API_KEY selects Gemini.
# AGENT_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
